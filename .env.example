APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./signalwake.db
# For Compose/Postgres, override DATABASE_URL with a complete URL and
# percent-encode username/password URI delimiters when present.
INGEST_ON_STARTUP=true
USE_DEMO_DATA=true
NWS_ALERTS_URL=https://api.weather.gov/alerts/active?status=actual
NWS_OBSERVATIONS_URL=https://api.weather.gov/observations?limit=500
USGS_EARTHQUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_WATER_URL=https://waterservices.usgs.gov/nwis/iv/?format=json&parameterCd=00060&siteStatus=active
USGS_WATER_STATES=VA,CA,TX,WA,FL,NY,PA,OH,IL,CO,AZ,NC
NHC_URL=https://www.nhc.noaa.gov/CurrentStorms.json
# Optional: FIRMS emits no records until a real free MAP_KEY is supplied.
FIRMS_MAP_KEY=
FIRMS_AREA=USA
FIRMS_PRODUCT=VIIRS_SNPP_NRT
FIRMS_DAYS=2
FIRMS_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
# Optional: AirNow emits no records until a real API key is supplied.
AIRNOW_API_KEY=
AIRNOW_BBOX=-130,20,-60,55
AIRNOW_PARAMETERS=PM25,OZONE
AIRNOW_URL=https://www.airnowapi.org/aq/data/
# NOAA CO-OPS is public; blank station IDs use a capped metadata subset.
NOAA_COOPS_STATION_IDS=
NOAA_COOPS_STATION_LIMIT=10
NOAA_COOPS_METADATA_URL=https://api.tidesandcurrents.noaa.gov/mdapi/prod/webapi/stations.json?type=waterlevels&units=metric
NOAA_COOPS_DATA_URL=https://api.tidesandcurrents.noaa.gov/api/prod/datagetter
# NASA EONET is a no-key natural-events request bounded to a USA bbox and 2 days.
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events/geojson?status=all&days=2&bbox=-130,55,-60,20&limit=500
NASA_EONET_BBOX=-130,55,-60,20
NASA_EONET_DAYS=2
NASA_EONET_LIMIT=500
# AviationWeather.gov PIREPs are a no-key single request bounded to 48 hours.
AVIATION_WEATHER_URL=https://aviationweather.gov/api/data/pirep?age=48&format=geojson
AVIATION_WEATHER_BBOX=
AVIATION_WEATHER_AGE_HOURS=48
AVIATION_WEATHER_LIMIT=400
# FEMA current designations are a no-key ArcGIS GeoJSON request capped at 2,000 polygons.
FEMA_DECLARATIONS_URL=https://gis.fema.gov/arcgis/rest/services/FEMA/DECS_ALL/FeatureServer/0/query?where=1%3D1&outFields=*&returnGeometry=true&outSR=4326&f=geojson
FEMA_DECLARATIONS_LIMIT=2000
SOURCE_USER_AGENT=signalwake-portfolio/0.1 (contact@example.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
